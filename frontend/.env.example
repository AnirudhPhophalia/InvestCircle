# ===========================================
# InvestCircle Frontend Environment Variables
# ===========================================

# Backend API base URL
# In local development: http://localhost:4000/api
# In production on Vercel: /api (served on the same domain)
VITE_API_URL=http://localhost:4000/api

# -------------------------------------------
# Optional Client-Side Overrides
# -------------------------------------------

# Google Gemini API Key
# If set here, the frontend can use this key as the default for accuracy calculations.
# (Users can also provide their key interactively in the profile UI or configure GEMINI_API_KEY on the backend)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

