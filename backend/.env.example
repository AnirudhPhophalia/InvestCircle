# ==========================================
# InvestCircle Backend Environment Variables
# ==========================================

# Port for the Express backend server (default: 4000)
PORT=4000

# PostgreSQL Connection String
# For local Postgres: postgresql://username:password@localhost:5432/investcircle
# For hosted Postgres (Neon, Supabase, Vercel Postgres): postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://localhost:5432/investcircle

# Frontend URL allowed by CORS in development (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign and verify JWT authentication tokens
# In production, use a strong, cryptographically secure random string
JWT_SECRET=investcircle-dev-secret

# Node environment mode ('development' or 'production')
# When set to 'production', cookies are marked secure
NODE_ENV=development

# ------------------------------------------
# External APIs (Optional)
# ------------------------------------------

# Finnhub API Key for live market news fetching in Discussions & NewsReel
# Get a free API key at: https://finnhub.io/
FINNHUB_API_KEY=

# Google Gemini API Key for sentiment hit-rate accuracy calculation
# Verifies user discussion stances against online market data
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
