# ========================================================
# InvestCircle Monorepo Environment Variables Reference
# ========================================================
#
# Copy this file or the respective subfolder examples:
#   - Backend:  backend/.env.example  -> backend/.env
#   - Frontend: frontend/.env.example -> frontend/.env
#
# ========================================================

# --------------------------------------------------------
# Backend Configuration (backend/.env)
# --------------------------------------------------------

# Port for local Express API server
PORT=4000

# PostgreSQL database connection string (required)
# Local: postgresql://postgres:postgres@localhost:5432/investcircle
# Hosted (Neon/Vercel/Supabase): postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://localhost:5432/investcircle

# Allowed origin for CORS in local development
CORS_ORIGIN=http://localhost:5173

# Secret key for JWT session cookies
JWT_SECRET=investcircle-dev-secret

# Node runtime environment
NODE_ENV=development

# Finnhub API Key for live market news (optional)
# Free key: https://finnhub.io/
FINNHUB_API_KEY=

# Google Gemini API Key for sentiment hit-rate accuracy engine (optional)
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --------------------------------------------------------
# Frontend Configuration (frontend/.env)
# --------------------------------------------------------

# API base endpoint for Vite frontend
VITE_API_URL=http://localhost:4000/api

# Optional default Gemini API Key for frontend accuracy calculation
VITE_GEMINI_API_KEY=


# OpenRouter API key for LLM access (optional)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
